<UserControl x:Class="SyncManager.Wpf.Controls.SummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Cartão de indicador: ícone colorido + número grande + legenda. O texto sempre acompanha a cor. -->
    <Border Padding="8,5" Margin="0,0,6,4" ToolTip="{Binding Hint, ElementName=Root}">
        <Border.Style>
            <!-- com comando, o cartão reage ao mouse: clicar nele seleciona os itens que ele conta -->
            <Style TargetType="Border" BasedOn="{StaticResource StatCard}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding Focusable, ElementName=Root}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <Path x:Name="IconPath" Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                  Fill="{Binding Accent, ElementName=Root}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="17" FontWeight="Bold"
                           Foreground="{Binding Accent, ElementName=Root}"/>
                <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
