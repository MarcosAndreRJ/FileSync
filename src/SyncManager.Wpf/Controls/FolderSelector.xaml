<UserControl x:Class="SyncManager.Wpf.Controls.FolderSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
             x:Name="Root">
    <!--
        Cartão de seleção de pasta: título, caminho, botão de procurar e área de soltar ("DropZone").
        Aceita pasta/arquivo local ou de rede arrastado do Explorer (arquivo → usa a pasta que o contém).
    -->
    <Border x:Name="Card" Style="{Binding CardStyle, ElementName=Root}" AllowDrop="True"
            PreviewDragEnter="OnDragEnter" PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Path Data="{StaticResource IconFolder}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"
                      Fill="{Binding AccentBrush, ElementName=Root}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Header, ElementName=Root}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{Binding AccentBrush, ElementName=Root}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Text="{Binding FolderPath, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         AllowDrop="True" PreviewDragEnter="OnDragEnter" PreviewDragOver="OnDragOver"
                         PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="9,5" ctl:Icon.Data="{StaticResource IconFolder}" ctl:Icon.Size="16"
                        Command="{Binding BrowseCommand, ElementName=Root}" ToolTip="Selecionar pasta..."
                        AutomationProperties.Name="Selecionar pasta"/>
            </Grid>

            <!-- Área de soltar: tracejada; muda de cor ao arrastar (válido = azul, inválido = vermelho) -->
            <Grid x:Name="Zone" Margin="0,6,0,0" Height="30" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnZoneClick">
                <Rectangle x:Name="ZoneBorder" RadiusX="6" RadiusY="6" StrokeDashArray="4 3" StrokeThickness="1.2"
                           Stroke="{DynamicResource TextSecondaryBrush}" Fill="Transparent"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="ZoneIcon" Data="{StaticResource IconDownload}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ZoneText" Text="Arraste uma pasta ou arquivo aqui ou clique para selecionar"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
