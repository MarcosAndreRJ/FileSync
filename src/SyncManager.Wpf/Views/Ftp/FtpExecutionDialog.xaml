<Window x:Class="SyncManager.Wpf.Views.Ftp.FtpExecutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
        Title="Execução de Transferência FTP / FTPS"
        Width="780" Height="620" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource SmallMutedText}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}">
                        <Run Text="Transferência: "/>
                        <Run Text="{Binding Task.Name, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}"/>
                </StackPanel>

                <!-- Velocidade e ETA no Cabeçalho -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource PanelBorder}" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Velocidade" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TransferSpeedFormatted}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Padding="10,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Tempo Restante" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EtaFormatted}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Seção de Barras de Progresso -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Progresso Global -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Progresso Global da Sincronização" FontWeight="SemiBold"/>
                    <TextBlock HorizontalAlignment="Right">
                        <Run Text="{Binding CompletedFilesCount, Mode=OneWay}"/>
                        <Run Text=" de "/>
                        <Run Text="{Binding TotalFilesCount, Mode=OneWay}"/>
                        <Run Text=" arquivos ("/>
                        <Run Text="{Binding FormattedTransferredBytes, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding FormattedTotalBytes, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Value="{Binding OverallProgressPercentage}" Minimum="0" Maximum="100" Height="14" Margin="0,0,0,12"/>

                <!-- Progresso do Arquivo Atual -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Arquivo Atual em Trânsito" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding CurrentFileName}" HorizontalAlignment="Right" Style="{StaticResource SmallMutedText}" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </Grid>
                <ProgressBar Value="{Binding CurrentFilePercentage}" Minimum="0" Maximum="100" Height="8"/>
            </StackPanel>
        </Border>

        <!-- Console de Logs em Tempo Real -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Log de Operações em Tempo Real" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="ExecutionLogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,2">
                                    <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='[{0:HH:mm:ss}]'}" Foreground="#888888"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Severity, Mode=OneWay, StringFormat='[{0}]'}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="INFO">
                                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="SUCCESS">
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#FFB74D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#EF5350"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Message, Mode=OneWay}" Foreground="#DCDCDC"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra Inferior de Ações -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left" Content="Cancelar Operação" Style="{StaticResource DangerButton}"
                        Command="{Binding CancelTransferCommand}" Padding="18,7"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

                <Button HorizontalAlignment="Right" Content="Fechar" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CloseCommand}" Padding="24,7"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
