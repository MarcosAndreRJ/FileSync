<Window x:Class="SyncManager.Wpf.Views.Ftp.FtpTaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
        xmlns:mvvm="clr-namespace:SyncManager.Wpf.Mvvm"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="#B8CBD5E3"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <mvvm:InverseBooleanToVisibilityConverter x:Key="NotBoolToVis"/>
        <Style x:Key="RuleRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Resultado de verificação de caminho -->
        <Style x:Key="CheckText" TargetType="TextBlock" BasedOn="{StaticResource WizardInfoText}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalCheck}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding LocalCheck}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="40,30">
        <ctl:WizardFrame x:Name="Frame" MaxWidth="1110" Height="730" HorizontalAlignment="Center" VerticalAlignment="Center"
                         WizardTitle="{Binding WindowTitle}" WizardSubtitle="{Binding WindowSubtitle}"
                         Steps="{Binding Steps}" CloseCommand="{Binding CancelCommand}" NavigateCommand="{Binding NavigateCommand}"
                         FooterNote="{Binding FooterNote}">
            <ctl:WizardFrame.WizardContent>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="StepLabel" Text="{Binding StepLabel}" Style="{StaticResource WizardEyebrow}"/>
                        <TextBlock x:Name="StepHeading" Text="{Binding StepHeading}" Style="{StaticResource WizardHeading}"/>
                        <TextBlock x:Name="StepDescription" Text="{Binding StepDescription}" Style="{StaticResource WizardDescription}"/>
                    </StackPanel>

                    <!-- 1. Geral: definir tarefa e caminhos -->
                    <ScrollViewer x:Name="Step1Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Nome da tarefa" Style="{StaticResource WizardLabel}"/>
                            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="Nome da tarefa"/>
                            <TextBlock x:Name="NameError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Descrição" Style="{StaticResource WizardLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="Descrição"/>

                            <TextBlock Text="Conexão remota" Style="{StaticResource WizardLabel}"/>
                            <ComboBox x:Name="ProfileBox" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Padding="10,8" AutomationProperties.Name="Conexão remota"/>
                            <TextBlock x:Name="ProfileError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasProfileError, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>

                            <TextBlock Text="Origem local" Style="{StaticResource WizardLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceBox" Text="{Binding SourceLocalPath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontFamily="Consolas" AutomationProperties.Name="Origem local"/>
                                <Button Grid.Column="1" Content="📂 Procurar…" Command="{Binding BrowseLocalFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="SourceError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasSourceError, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Destino remoto" Style="{StaticResource WizardLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TargetBox" Text="{Binding TargetRemotePath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontFamily="Consolas" AutomationProperties.Name="Destino remoto"/>
                                <Button Grid.Column="1" Content="📁 Procurar no servidor…" Command="{Binding BrowseRemoteCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="TargetError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasTargetError, Converter={StaticResource BoolToVis}}"/>

                            <Border x:Name="ReuseHint" Style="{StaticResource WizardInfoBorder}">
                                <TextBlock Style="{StaticResource WizardInfoText}"
                                           Text="Uma conexão pode ser utilizada por diversas tarefas. Cada tarefa mantém seus próprios caminhos, seleção e método de transferência."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. Conexão e caminhos: examinar, navegar e confirmar o mapeamento -->
                    <ScrollViewer x:Name="Step2Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="📂 Origem local" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding SourceLocalPath}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="LocalCheckText" Text="{Binding LocalCheckText}" Style="{StaticResource CheckText}" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Examinar origem" Command="{Binding CheckLocalCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="Alterar…" Command="{Binding BrowseLocalFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="🖧 Destino FTP" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding TargetRemotePath}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="RemoteCheckText" Text="{Binding RemoteCheckText}" Style="{StaticResource WizardInfoText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Verificar destino" Command="{Binding CheckRemoteCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"/>
                                            <Button Content="Navegar no servidor…" Command="{Binding BrowseRemoteCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource WizardInfoBorder}">
                                <StackPanel>
                                    <TextBlock Text="Mapeamento da tarefa" FontWeight="SemiBold" Style="{StaticResource WizardInfoText}"/>
                                    <TextBlock x:Name="MappingText" Text="{Binding MappingText}" FontFamily="Consolas" Style="{StaticResource WizardInfoText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="Step2Error" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasSourceError, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Para alterar nome, conexão ou caminhos digitados, volte à etapa Geral. O destino é conferido de verdade no servidor; se não puder ser confirmado, você será avisado antes de salvar."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. Método: cartões de escolha + execução -->
                    <ScrollViewer x:Name="Step3Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <ItemsControl x:Name="MethodCards" ItemsSource="{Binding MethodChoices}" IsTabStop="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="Method" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource MethodCard}" AutomationProperties.Name="{Binding Label}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14.5"/>
                                                <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,4,0,0"/>
                            <TextBlock Text="Configurações da execução" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,6"/>
                            <CheckBox IsChecked="True" IsEnabled="False" Content="Exigir checklist e aprovação explícita antes de transferir (sempre ativo)" Margin="0,4,0,0"/>
                            <CheckBox IsChecked="{Binding BackupBeforeOverwrite}" Content="Criar backup dos arquivos antes de sobrescrever" Margin="0,8,0,0"/>
                            <CheckBox IsChecked="{Binding ProhibitRemoteDeletions}" Content="Bloquear exclusões de arquivos remotos" Margin="0,8,0,0"/>
                            <CheckBox IsChecked="{Binding RequireExplicitChecklistConfirmation}" Content="Exigir confirmação específica no checklist quando houver exclusões" Margin="0,8,0,0"/>
                            <CheckBox IsChecked="{Binding UseAtomicUpload}" Content="Upload atômico (arquivo temporário renomeado após o sucesso)" Margin="0,8,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Estratégia de comparação" Style="{StaticResource WizardLabel}"/>
                                    <ComboBox ItemsSource="{Binding StrategyOptions}" SelectedItem="{Binding SelectedStrategy}" DisplayMemberPath="Label" Padding="10,7" AutomationProperties.Name="Estratégia de comparação"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tolerância (segundos)" Style="{StaticResource WizardLabel}"/>
                                    <TextBox Text="{Binding TimestampToleranceSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="MethodWarningBox" Style="{StaticResource WizardWarnBorder}">
                                <TextBlock x:Name="MethodWarningText" Text="{Binding MethodWarning}" Style="{StaticResource WizardInfoText}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 4. Pastas selecionadas -->
                    <Grid x:Name="Step4Panel" Grid.Row="1" Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="TabFiles" Content="Pastas e arquivos" GroupName="SelTab" IsChecked="{Binding IsTabFiles, Mode=TwoWay}" Style="{StaticResource WizardTab}"/>
                            <RadioButton x:Name="TabExceptions" Content="Exceções" GroupName="SelTab" IsChecked="{Binding IsTabExceptions, Mode=TwoWay}" Style="{StaticResource WizardTab}"/>
                            <RadioButton x:Name="TabPreview" Content="Prévia das regras" GroupName="SelTab" IsChecked="{Binding IsTabPreview, Mode=TwoWay}" Style="{StaticResource WizardTab}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <!-- aba: pastas e arquivos (origem selecionável + destino somente leitura) -->
                            <Grid x:Name="TabFilesPanel" Visibility="{Binding IsTabFiles, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Origem (local)" FontWeight="SemiBold" FontSize="14"/>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="0,6,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding SourceLocalPath}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </StackPanel>
                                        <TreeView Grid.Row="1" x:Name="SelectionTree" ItemsSource="{Binding LocalRoots}" ItemContainerStyle="{StaticResource FsTreeItemStyle}"
                                                  ItemTemplate="{StaticResource FsNodeTemplate}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Árvore da origem local"/>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="Carregando pasta local…" Style="{StaticResource SmallMutedText}" Visibility="{Binding IsLoadingTree, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding TreeMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding HasTreeMessage, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Tentar novamente" Command="{Binding RetryTreeCommand}" Style="{StaticResource SecondaryButton}" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding HasTreeMessage, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Destino (FTP) — somente leitura" FontWeight="SemiBold" FontSize="14"/>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="0,6,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding TargetRemotePath}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </StackPanel>
                                        <TreeView Grid.Row="1" x:Name="RemoteTree" ItemsSource="{Binding RemoteRoots}" ItemContainerStyle="{StaticResource FsTreeItemStyle}"
                                                  ItemTemplate="{StaticResource FsNodeTemplate}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Árvore do destino FTP"/>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="Consultando o servidor…" Style="{StaticResource SmallMutedText}" Visibility="{Binding IsLoadingRemote, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock x:Name="RemoteMessageText" Text="{Binding RemoteMessage}" TextWrapping="Wrap" Style="{StaticResource SmallMutedText}" Visibility="{Binding HasRemoteMessage, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Tentar novamente" Command="{Binding RetryRemoteCommand}" Style="{StaticResource SecondaryButton}" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- aba: exceções -->
                            <Border x:Name="TabExceptionsPanel" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="{Binding IsTabExceptions, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Exceções por caminho e padrão" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Exceções prevalecem dentro das pastas selecionadas. Para criar uma exceção por caminho, desmarque a subpasta ou o arquivo na aba Pastas e arquivos."
                                                   Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Exclusions}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RuleRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="−" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Text, Mode=OneWay}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Nenhuma exceção definida." Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Exclusions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- aba: prévia -->
                            <Border x:Name="TabPreviewPanel" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="{Binding IsTabPreview, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Prévia das regras (varredura real da pasta local)" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="PreviewSummary" Text="{Binding PreviewSummary}" Style="{StaticResource WizardInfoText}" Margin="0,4,0,8"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WizardInfoBorder}" Margin="0">
                                    <TextBlock x:Name="SelectionSummaryText" Text="{Binding SelectionSummary}" Style="{StaticResource WizardInfoText}"/>
                                </Border>
                                <Button Grid.Column="1" Content="Limpar seleção" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="SelectionError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasSelectionError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 5. Filtros: regras de inclusão e exceções -->
                    <ScrollViewer x:Name="Step5Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep5, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}" Padding="16,12" MinHeight="200">
                                    <StackPanel>
                                        <TextBlock Text="Regras de inclusão" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="As pastas e arquivos marcados na etapa anterior formam a seleção principal." Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <ItemsControl x:Name="InclusionList" ItemsSource="{Binding InclusionRules}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RuleRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="＋" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Mode=OneWay, StringFormat='{}{0}/**'}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="2" Content="Remover" Style="{StaticResource LinkButton}"
                                                                    Command="{Binding DataContext.RemoveInclusionCommand, RelativeSource={RelativeSource AncestorType=ctl:WizardFrame}}" CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Nenhuma inclusão: volte à etapa anterior e marque ao menos uma pasta ou arquivo." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasSelection, Converter={StaticResource NotBoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16,12" MinHeight="200">
                                    <StackPanel>
                                        <TextBlock Text="Arquivos e pastas excluídos" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Exceções prevalecem dentro das pastas selecionadas." Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <ItemsControl x:Name="ExclusionList" ItemsSource="{Binding Exclusions}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource RuleRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="−" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" BorderThickness="0" Background="Transparent" Padding="0,2"
                                                                     IsReadOnly="{Binding IsPath}" AutomationProperties.Name="Exceção"/>
                                                            <Button Grid.Column="2" Content="Remover" Style="{StaticResource LinkButton}"
                                                                    Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ctl:WizardFrame}}" CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewExclusionBox" Text="{Binding NewExclusionText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontFamily="Consolas" AutomationProperties.Name="Nova exceção (ex.: **/*.log)">
                                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddExclusionCommand}"/></TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" x:Name="AddExclusionButton" Content="＋ Adicionar exceção" Command="{Binding AddExclusionCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="Exemplos: .env, **/.env.*, **/node_modules/**, **/*.log" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="ImpactBox" Style="{StaticResource WizardInfoBorder}">
                                <StackPanel>
                                    <TextBlock Text="Efeito das exceções sobre a seleção" FontWeight="SemiBold" Style="{StaticResource WizardInfoText}"/>
                                    <TextBlock x:Name="ImpactText" Text="{Binding PreviewSummary}" Style="{StaticResource WizardInfoText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="SensitiveBox" Style="{StaticResource WizardWarnBorder}">
                                <TextBlock x:Name="SensitiveText" Text="{Binding SensitiveWarning}" Style="{StaticResource WizardInfoText}"/>
                            </Border>

                            <Expander Header="Predefinições, implantação e notificações" Margin="0,14,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableFrameworkPresets}" SelectedItem="{Binding FrameworkPreset}" Padding="8,6"/>
                                        <Button Grid.Column="1" Content="Aplicar predefinição" Command="{Binding ApplyPresetExclusionsCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding FrameworkPresetDescription}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding PresetMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <CheckBox IsChecked="{Binding EnableMaintenanceMode}" Content="Criar arquivo de manutenção durante o deploy" Margin="0,12,0,0"/>
                                    <CheckBox IsChecked="{Binding NotifyOnCompletion}" Content="Notificar ao concluir (webhook)" Margin="0,8,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableWebhookTypes}" SelectedItem="{Binding WebhookType}" Padding="8,6" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                        <Button Grid.Column="2" Content="Testar" Command="{Binding TestWebhookCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 6. Revisão (dados reais do ViewModel) -->
                    <ScrollViewer x:Name="Step6Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep6, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <ItemsControl x:Name="ReviewList" ItemsSource="{Binding ReviewSections}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PanelBorder}" Padding="16,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                    <Button Grid.Column="1" Content="Editar" Style="{StaticResource LinkButton}"
                                                            Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType=ctl:WizardFrame}}" CommandParameter="{Binding EditStep}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Lines}" IsTabStop="False" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource SmallMutedText}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="WarningsBox" Style="{StaticResource WizardWarnBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Avisos" FontWeight="SemiBold" Style="{StaticResource WizardInfoText}"/>
                                    <ItemsControl x:Name="WarningsList" ItemsSource="{Binding ReviewWarnings}" IsTabStop="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Mode=OneWay, StringFormat='• {0}'}" Style="{StaticResource WizardInfoText}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border x:Name="SaveNotice" Style="{StaticResource WizardErrorBorder}" Visibility="{Binding HasGeneralError, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="SaveNoticeText" Text="{Binding ValidationMessage}" Style="{StaticResource WizardInfoText}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ctl:WizardFrame.WizardContent>

            <ctl:WizardFrame.FooterButtons>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Padding="18,8" Margin="0,0,24,0"/>
                    <Button x:Name="BackButton" Content="‹ Voltar" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Padding="18,8" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsDefault="True" Padding="20,8"
                            Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="SaveButton" Content="Salvar tarefa" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Padding="20,8"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ctl:WizardFrame.FooterButtons>
        </ctl:WizardFrame>
    </Grid>
</Window>
