<Window x:Class="SyncManager.Wpf.Views.Ftp.FtpConnectionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
        xmlns:mvvm="clr-namespace:SyncManager.Wpf.Mvvm"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="#B8CBD5E3"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <mvvm:InverseBooleanToVisibilityConverter x:Key="NotBoolToVis"/>
    </Window.Resources>

    <Grid Margin="40,40">
        <ctl:WizardFrame x:Name="Frame" MaxWidth="1110" Height="690" HorizontalAlignment="Center" VerticalAlignment="Center"
                         WizardTitle="{Binding WindowTitle}" WizardSubtitle="{Binding WindowSubtitle}"
                         Steps="{Binding Steps}" CloseCommand="{Binding CancelCommand}" NavigateCommand="{Binding NavigateCommand}"
                         FooterNote="{Binding FooterNote}">
            <ctl:WizardFrame.WizardContent>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding StepLabel}" Style="{StaticResource WizardEyebrow}"/>
                        <TextBlock x:Name="StepHeading" Text="{Binding StepHeading}" Style="{StaticResource WizardHeading}"/>
                        <TextBlock x:Name="StepDescription" Text="{Binding StepDescription}" Style="{StaticResource WizardDescription}"/>
                    </StackPanel>

                    <!-- Etapa 1: Dados da conexão -->
                    <ScrollViewer x:Name="Step1Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Nome da conexão" Style="{StaticResource WizardLabel}"/>
                            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="Nome da conexão"/>
                            <TextBlock x:Name="NameError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Protocolo" Style="{StaticResource WizardLabel}"/>
                                    <ComboBox x:Name="ProtocolBox" ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}" DisplayMemberPath="Label" Padding="10,8" AutomationProperties.Name="Protocolo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Porta" Style="{StaticResource WizardLabel}"/>
                                    <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="Porta"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Servidor / host" Style="{StaticResource WizardLabel}"/>
                            <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="Servidor"/>
                            <TextBlock x:Name="HostError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasHostError, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Diretório remoto inicial" Style="{StaticResource WizardLabel}"/>
                            <TextBox Text="{Binding DefaultRemotePath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontFamily="Consolas" AutomationProperties.Name="Diretório remoto inicial"/>

                            <Border x:Name="ProtocolHint" Style="{StaticResource WizardInfoBorder}">
                                <TextBlock Style="{StaticResource WizardInfoText}">
                                    <Run Text="Recomendado:" FontWeight="Bold"/> <Run Text="{Binding ProtocolRecommendation, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <Border x:Name="PlainWarning" Style="{StaticResource WizardErrorBorder}" Visibility="{Binding IsPlainFtp, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource WizardInfoText}" Text="O protocolo selecionado não usa criptografia. Suas credenciais e arquivos trafegarão em texto puro."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Etapa 2: Segurança e autenticação -->
                    <ScrollViewer x:Name="Step2Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Usuário FTP" Style="{StaticResource WizardLabel}"/>
                                    <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="Usuário FTP"/>
                                    <TextBlock x:Name="UserError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasUserError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Senha (protegida pelo Windows)" Style="{StaticResource WizardLabel}"/>
                                    <PasswordBox x:Name="UserPasswordBox" PasswordChanged="OnPasswordChanged" Padding="10,8" AutomationProperties.Name="Senha"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Criptografia" Style="{StaticResource WizardLabel}"/>
                                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}" DisplayMemberPath="Label" Padding="10,8" AutomationProperties.Name="Criptografia"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Modo de transferência" Style="{StaticResource WizardLabel}"/>
                                    <ComboBox ItemsSource="{Binding TransferModeOptions}" SelectedItem="{Binding SelectedTransferMode}" DisplayMemberPath="Label" Padding="10,8" AutomationProperties.Name="Modo de transferência"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,18,0,0"/>
                            <TextBlock Text="Proteções de conexão" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,4"/>
                            <CheckBox IsChecked="True" IsEnabled="False" Margin="0,6,0,0" Content="Validar o certificado TLS do servidor (sempre ativo; certificados inválidos ou não confiáveis são recusados)"/>
                            <CheckBox IsChecked="{Binding RequireTls12OrHigher}" Margin="0,8,0,0" Content="Exigir TLS 1.2 ou superior (rejeita TLS 1.0/1.1)"/>
                            <CheckBox x:Name="PinningBox" IsChecked="{Binding CertificatePinning}" Margin="0,8,0,0" Content="Certificate Pinning: aceitar somente o certificado com o thumbprint informado"/>
                            <StackPanel Visibility="{Binding CertificatePinning, Converter={StaticResource BoolToVis}}" Margin="24,4,0,0">
                                <TextBox x:Name="ThumbprintBox" Text="{Binding ExpectedCertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" FontFamily="Consolas" AutomationProperties.Name="Thumbprint esperado"/>
                                <TextBlock x:Name="AdvancedError" Text="{Binding ValidationMessage}" Style="{StaticResource WizardFieldError}" Visibility="{Binding HasAdvancedError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <CheckBox IsChecked="True" IsEnabled="False" Margin="0,8,0,0" Content="Guardar a senha com a proteção do Windows (DPAPI), fora do banco de dados (sempre ativo)"/>

                            <Expander Header="Opções avançadas (timeout, paralelismo, ModTime, webhook)" Margin="0,16,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Timeout (segundos)" Style="{StaticResource WizardLabel}"/>
                                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="10,6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Conexões simultâneas (1 a 10)" Style="{StaticResource WizardLabel}"/>
                                            <TextBox Text="{Binding MaxParallelConnections, UpdateSourceTrigger=PropertyChanged}" Padding="10,6"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding PreserveModTime}" Content="Preservar data de modificação (MFMT / MDTM) quando o servidor suportar" Margin="0,10,0,0"/>
                                    <CheckBox IsChecked="{Binding SendKeepAlive}" Content="Enviar Keep-Alive (NOOP) em conexões ociosas" Margin="0,6,0,0"/>
                                    <TextBlock Text="Webhook padrão de notificações (opcional)" Style="{StaticResource WizardLabel}" Margin="0,12,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableWebhookTypes}" SelectedItem="{Binding DefaultWebhookType}" Padding="8,6" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding DefaultWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                        <Button Grid.Column="2" Content="Testar" Command="{Binding TestDefaultWebhookCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Border x:Name="SecurityHint" Style="{StaticResource WizardInfoBorder}">
                                <TextBlock Style="{StaticResource WizardInfoText}"
                                           Text="O FileSync não aceita certificados inválidos de maneira silenciosa. As credenciais ficam fora do banco SQLite em texto puro."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Etapa 3: diagnóstico orientado -->
                    <Grid x:Name="Step3Panel" Grid.Row="1" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,0">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,6">
                                    <ItemsControl x:Name="DiagnosticsList" ItemsSource="{Binding Diagnostics.Steps}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="14" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="○"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunningStep}" Value="True"><Setter Property="Text" Value="◌"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter Property="Text" Value="●"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Text" Value="◐"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Text" Value="✕"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding StepName}"/>
                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource SmallMutedText}" VerticalAlignment="Top" Margin="12,2,0,0" FontWeight="SemiBold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border x:Name="TestOk" Style="{StaticResource WizardOkBorder}" Visibility="{Binding TestPassed, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✓ Conexão testada com sucesso" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}"/>
                                </Border>
                                <Border x:Name="TestPending" Style="{StaticResource WizardWarnBorder}" Visibility="{Binding TestPassed, Converter={StaticResource NotBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock x:Name="TestStatus" Text="{Binding TestStatusText}" Style="{StaticResource WizardInfoText}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TestGuidance" Text="{Binding TestGuidance}" Style="{StaticResource WizardInfoText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="SaveNotice" Style="{StaticResource WizardErrorBorder}" Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}">
                                    <TextBlock x:Name="ValidationText" Text="{Binding ValidationMessage}" Style="{StaticResource WizardInfoText}" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="RunTestButton" Content="Executar teste novamente" Command="{Binding RunTestCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                            <Button x:Name="OpenBrowserButton" Content="Abrir navegador remoto" Command="{Binding OpenBrowserCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                    ToolTip="Disponível somente após um teste bem-sucedido"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ctl:WizardFrame.WizardContent>

            <ctl:WizardFrame.FooterButtons>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Padding="18,8" Margin="0,0,24,0"/>
                    <Button x:Name="BackButton" Content="‹ Voltar" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" Padding="18,8" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsDefault="True" Padding="20,8"
                            Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="SaveButton" Content="{Binding SaveButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Padding="20,8"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ctl:WizardFrame.FooterButtons>
        </ctl:WizardFrame>
    </Grid>
</Window>
