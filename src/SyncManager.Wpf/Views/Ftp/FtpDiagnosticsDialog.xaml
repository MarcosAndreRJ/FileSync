<Window x:Class="SyncManager.Wpf.Views.Ftp.FtpDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
        Title="Diagnóstico de Conexão e Protocolo FTP"
        Width="780" Height="650" MinWidth="680" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Diagnóstico em 8 Etapas"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding ServerInfo}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Executar Novamente" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}" Padding="16,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Etapas de Diagnóstico (Grid ou Lista com Status) -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8">
            <DataGrid ItemsSource="{Binding Steps}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" RowHeight="26" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Etapa de Verificação" Binding="{Binding StepName}" Width="240" FontWeight="SemiBold"/>
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Resultado / Mensagem" Binding="{Binding Message}" Width="1.5*"/>
                    <DataGridTextColumn Header="Duração" Binding="{Binding Duration.TotalMilliseconds, StringFormat='{}{0:F0} ms'}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Divisor redimensionável -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

        <!-- Painel de Logs de Protocolo FTP -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Comunicação de Protocolo em Tempo Real (RFC 959 / 4217)" Style="{StaticResource CardTitle}"/>
                <Button HorizontalAlignment="Right" Content="Copiar Logs" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyLogsCommand}" Padding="10,3"/>
            </Grid>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding ProtocolLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas, Courier New, monospace" FontSize="11" Margin="0,1">
                                    <Run Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss.fff}]'}" Foreground="#888888"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Direction, StringFormat='[{0}]'}" Foreground="#4EC9B0"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Message}" Foreground="#DCDCDC"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra Inferior -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusSummary}" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverallSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Cancelar Teste" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="14,6"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Fechar" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloseCommand}" Padding="20,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
