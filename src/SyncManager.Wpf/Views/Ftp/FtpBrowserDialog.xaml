<Window x:Class="SyncManager.Wpf.Views.Ftp.FtpBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1000" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Navegador FTP"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding ServerInfo}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Padding="14,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Origem local (opcional) -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="12"
                    Visibility="{Binding HasLocalPane, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="📂 Origem local" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding LocalPath, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,8" Padding="8,5" FontFamily="Consolas"/>
                    </StackPanel>
                    <TreeView Grid.Row="1" x:Name="LocalTree" ItemsSource="{Binding LocalRoots}" ItemContainerStyle="{StaticResource FsTreeItemStyle}"
                              ItemTemplate="{StaticResource FsNodeTemplate}" BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>

            <!-- Destino FTP -->
            <Border Grid.Column="2" Grid.ColumnSpan="1" Style="{StaticResource PanelBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="🖧 Destino FTP" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="↑" Command="{Binding UpCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0" ToolTip="Subir um nível"/>
                            <TextBox Grid.Column="1" x:Name="PathBox" Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" FontFamily="Consolas"/>
                            <Button Grid.Column="2" Content="Ir" Command="{Binding GoCommand}" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <TreeView Grid.Row="1" x:Name="RemoteTree" ItemsSource="{Binding RemoteRoots}" ItemContainerStyle="{StaticResource FsTreeItemStyle}"
                              ItemTemplate="{StaticResource FsNodeTemplate}" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="OnRemoteSelectedItemChanged"/>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="Carregando…" Style="{StaticResource SmallMutedText}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Fechar" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" Padding="18,7" Margin="0,0,8,0"/>
                <Button x:Name="UsePathButton" Content="Usar este caminho" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Padding="18,7"
                        Visibility="{Binding IsPickerMode, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
