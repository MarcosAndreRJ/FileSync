<UserControl x:Class="SyncManager.Wpf.Views.Pages.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Botão discreto de chevron para expansão na árvore -->
        <Style x:Key="ChevronToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de filtro tipo Pill -->
        <Style x:Key="FilterPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Indicador de resumo em cartão compacto -->
        <Style x:Key="IndicatorCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,10,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Configuração Rápida do Topo -->
            <RowDefinition Height="Auto"/>   <!-- 1: Barra compacta de indicadores -->
            <RowDefinition Height="Auto"/>   <!-- 2: Filtros (Pills) e Busca -->
            <RowDefinition Height="*" MinHeight="250"/>   <!-- 3: Comparação em Dois Painéis Sincronizados -->
            <RowDefinition Height="Auto"/>   <!-- 4: Progresso e Detalhes da Execução -->
        </Grid.RowDefinitions>

        <!-- 0. CONFIGURAÇÃO RÁPIDA (CONFORME MOCKUP 1) -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linha 1: Perfil Ativo | Método de Sincronização | Botão Configurações -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Perfil ativo:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="200" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfileItem}"
                                  DisplayMemberPath="Name" ToolTip="Selecione um perfil salvo para carregar suas configurações"/>
                        <Button Style="{StaticResource NavButton}" Content="Limpar" Command="{Binding ClearProfileCommand}"
                                Margin="6,0,0,0" Padding="8,4" ToolTip="Limpar dados do perfil e campos de origem/destino"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Método de sincronização:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                        <ComboBox Width="260" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                                  DisplayMemberPath="Label" ToolTip="{Binding MethodDescription}"/>
                        <Button Style="{StaticResource NavButton}" Content="Configurações" Command="{Binding OpenSettingsCommand}"
                                ctl:Icon.Data="{StaticResource IconSettings}" Margin="10,0,0,0" Padding="12,6"
                                ToolTip="Abrir janela completa de configurações do perfil e opções avançadas"/>
                    </StackPanel>
                </Grid>

                <!-- Linha 2: Origem (Source) | Troca | Destino (Target) | Botoes de Ação -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Origem -->
                    <DockPanel Grid.Column="0" Margin="0,0,8,0" AllowDrop="True" PreviewDragOver="OnPathDragOver" Drop="OnSourceDrop">
                        <TextBlock DockPanel.Dock="Top" Text="Origem (Source):" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="32"
                                     AllowDrop="True" PreviewDragOver="OnPathDragOver" Drop="OnSourceDrop"/>
                            <Button Grid.Column="1" Command="{Binding BrowseSourceCommand}" ctl:Icon.Data="{StaticResource IconFolder}"
                                    Padding="10,6" Margin="4,0,0,0" ToolTip="Procurar pasta de origem"/>
                        </Grid>
                    </DockPanel>

                    <!-- Botão de Inversão -->
                    <Button Grid.Column="1" Command="{Binding SwapSidesCommand}" ctl:Icon.Data="{StaticResource IconSwap}"
                            Padding="8,6" Margin="4,16,4,0" VerticalAlignment="Center" ToolTip="Trocar Origem e Destino"/>

                    <!-- Destino -->
                    <DockPanel Grid.Column="2" Margin="8,0,12,0" AllowDrop="True" PreviewDragOver="OnPathDragOver" Drop="OnTargetDrop">
                        <TextBlock DockPanel.Dock="Top" Text="Destino (Target):" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="32"
                                     AllowDrop="True" PreviewDragOver="OnPathDragOver" Drop="OnTargetDrop"/>
                            <Button Grid.Column="1" Command="{Binding BrowseTargetCommand}" ctl:Icon.Data="{StaticResource IconFolder}"
                                    Padding="10,6" Margin="4,0,0,0" ToolTip="Procurar pasta de destino"/>
                        </Grid>
                    </DockPanel>

                    <!-- Botões Principais de Ação -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <Button Content="Comparar" Style="{StaticResource PrimaryButton}" Command="{Binding CompareCommand}"
                                ctl:Icon.Data="{StaticResource IconSearch}" Padding="18,7" MinWidth="110"/>
                        <Button Content="Visualizar plano" Command="{Binding PreviewCommand}"
                                ctl:Icon.Data="{StaticResource IconDocument}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Executar" Style="{StaticResource SuccessButton}" Command="{Binding ExecuteCommand}"
                                ctl:Icon.Data="{StaticResource IconPlay}" Padding="18,7" MinWidth="110"/>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Padding="12,7"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 1. BARRA COMPACTA DE INDICADORES (CONFORME MOCKUP 1) -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <UniformGrid Rows="1">
                <!-- Analisados -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconDocument}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeTotalAnalyzed}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" Analisados" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Iguais -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeIdenticalCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" Iguais" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Diferentes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconCompare}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeDifferentCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" Diferentes" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Só na origem -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconArrowRight}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeSourceOnlyCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" Só na origem" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Só no destino -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconArrowLeft}" Width="16" Height="16" Stretch="Uniform" Fill="#8B5CF6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeTargetOnlyCount}" FontWeight="Bold" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                    <TextBlock Text=" Só no destino" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Conflitos -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeConflictCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" Conflitos" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Erros -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconError}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeErrorCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" Erros" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Marcados para executar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TreeCheckedCount}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" Marcados" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- 2. FILTROS PILLS E PESQUISA (CONFORME MOCKUP 1) -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Mostrar:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterAllText}" Tag="{Binding FilterAllTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="All"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterDiffText}" Tag="{Binding FilterDiffTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="Different"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterIdenticalText}" Tag="{Binding FilterIdenticalTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="Identical"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterSourceOnlyText}" Tag="{Binding FilterSourceOnlyTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="SourceOnly"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterTargetOnlyText}" Tag="{Binding FilterTargetOnlyTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="TargetOnly"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterConflictText}" Tag="{Binding FilterConflictTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="Conflict"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterErrorText}" Tag="{Binding FilterErrorTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="Error"/>
                <Button Style="{StaticResource FilterPillButton}" Content="{Binding FilterCheckedText}" Tag="{Binding FilterCheckedTag}"
                        Command="{Binding SetTreeFilterCommand}" CommandParameter="Checked"/>
            </StackPanel>

            <!-- Campo de Busca -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="260" Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Pesquisar arquivos ou pastas por nome ou caminho..." AutomationProperties.Name="Pesquisar arquivos ou pastas"
                         Height="30" VerticalContentAlignment="Center"/>
                <Button Content="Expandir tudo" Padding="8,4" Margin="6,0,0,0" Command="{Binding ExpandAllTreeCommand}" ToolTip="Expandir todas as pastas"/>
                <Button Content="Recolher tudo" Padding="8,4" Margin="4,0,0,0" Command="{Binding CollapseAllTreeCommand}" ToolTip="Recolher todas as pastas"/>
            </StackPanel>
        </Grid>

        <!-- 3. COMPARAÇÃO EM DOIS PAINÉIS SINCRONIZADOS (CONFORME MOCKUPS 1 E 4) -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <!-- Cabeçalho descritivo com os dois diretórios -->
                <Grid DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Origem: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="6,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
                        <TextBlock Text="Status" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="2" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Destino: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding TargetPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rodapé de indicação de rolagem sincronizada -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Path Data="{StaticResource IconSync}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Rolagem sincronizada" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Path Data="{StaticResource IconSync}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Rolagem sincronizada" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Grade compartilhada de duas árvores alinhadas perfeitamente -->
                <Grid>
                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding TreeManager.FlatVisibleRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" PreviewKeyDown="OnGridKeyDown" SelectionMode="Extended" SelectionUnit="FullRow"
                              RowHeight="28" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              BorderThickness="0" Background="Transparent" HeadersVisibility="Column">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Marcar selecionados para executar" Click="OnMarkSelectedTree"/>
                                <MenuItem Header="Desmarcar selecionados" Click="OnUnmarkSelectedTree"/>
                                <MenuItem Header="Marcar somente selecionados" Click="OnIncludeOnlySelectedTree"/>
                                <Separator/>
                                <MenuItem Header="Ocultar item(ns) selecionado(s)" Click="OnHideSelectedTree"/>
                                <MenuItem Header="Restaurar todos os itens ocultos" Click="OnRestoreHiddenTree"/>
                                <Separator/>
                                <MenuItem Header="Expandir todas as pastas" Command="{Binding ExpandAllTreeCommand}"/>
                                <MenuItem Header="Recolher todas as pastas" Command="{Binding CollapseAllTreeCommand}"/>
                                <Separator/>
                                <MenuItem Header="Copiar selecionados: Origem → Destino" Click="OnCopyRightTree"/>
                                <MenuItem Header="Copiar selecionados: Destino → Origem" Click="OnCopyLeftTree"/>
                                <Separator/>
                                <MenuItem Header="Remover da lista / excluir..." Click="OnDeleteSelectedTree"/>
                                <Separator/>
                                <MenuItem Header="Conflito: Manter Origem" Click="OnKeepSourceTree"/>
                                <MenuItem Header="Conflito: Manter Destino" Click="OnKeepTargetTree"/>
                                <MenuItem Header="Conflito: Manter ambos" Click="OnKeepBothTree"/>
                                <MenuItem Header="Conflito: Ignorar" Click="OnIgnoreConflictTree"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- ORIGEM: Checkbox -->
                            <DataGridTemplateColumn Width="38" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><CheckBox ToolTip="Marcar/Desmarcar todos" Click="OnHeaderCheckAll"/></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding CanInclude, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ORIGEM: Nome do Arquivo/Pasta com Árvore Hierárquica -->
                            <DataGridTemplateColumn Header="Nome (Origem)" Width="2*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}" VerticalAlignment="Center">
                                            <!-- Botão de Expandir/Recolher -->
                                            <Button Style="{StaticResource ChevronToggleBtn}" Content="{Binding ExpandIconGlyph}"
                                                    Command="{Binding ToggleExpandCommand}"
                                                    Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Ícone de Pasta ou Arquivo -->
                                            <Path Data="{StaticResource IconFolder}" Width="15" Height="15" Stretch="Uniform" Fill="#F59E0B" Margin="0,0,6,0"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"/>
                                            <Path Data="{StaticResource IconDocument}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            <!-- Nome da Origem -->
                                            <TextBlock Text="{Binding SourceNameDisplay}" VerticalAlignment="Center"
                                                       FontWeight="{Binding FontWeight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ORIGEM: Tamanho -->
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding SourceSizeText}" Width="85" ElementStyle="{StaticResource RightAligned}"/>

                            <!-- ORIGEM: Modificado -->
                            <DataGridTextColumn Header="Modificado" Binding="{Binding SourceModifiedText}" Width="140"/>

                            <!-- COLUNA CENTRAL: STATUS / OPERAÇÃO -->
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2" CornerRadius="4">
                                            <TextBlock Text="{Binding StatusSymbol}" FontWeight="Bold" FontSize="14"
                                                       Foreground="{Binding StatusBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DESTINO: Checkbox -->
                            <DataGridTemplateColumn Width="38" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding CanInclude, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DESTINO: Nome do Arquivo/Pasta com Árvore Hierárquica -->
                            <DataGridTemplateColumn Header="Nome (Destino)" Width="2*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}" VerticalAlignment="Center">
                                            <!-- Botão de Expandir/Recolher -->
                                            <Button Style="{StaticResource ChevronToggleBtn}" Content="{Binding ExpandIconGlyph}"
                                                    Command="{Binding ToggleExpandCommand}"
                                                    Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Ícone de Pasta ou Arquivo -->
                                            <Path Data="{StaticResource IconFolder}" Width="15" Height="15" Stretch="Uniform" Fill="#F59E0B" Margin="0,0,6,0"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"/>
                                            <Path Data="{StaticResource IconDocument}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            <!-- Nome do Destino -->
                                            <TextBlock Text="{Binding TargetNameDisplay}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- DESTINO: Tamanho -->
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding TargetSizeText}" Width="85" ElementStyle="{StaticResource RightAligned}"/>

                            <!-- DESTINO: Modificado -->
                            <DataGridTextColumn Header="Modificado" Binding="{Binding TargetModifiedText}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado Vazio (Antes da primeira comparação) -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconCompare}" Width="48" Height="48" Stretch="Uniform" Fill="{DynamicResource DisabledBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhuma comparação realizada" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Escolha as pastas de Origem e Destino acima e clique em Comparar." Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 4. PROGRESSO E DETALHES DA EXECUÇÃO (RODAPÉ) -->
        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,8,0,0" Padding="12,6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource SmallMutedText}"
                               Text="Atalhos:  →  copia Origem → Destino   ←  Destino → Origem   Del  exclui   Espaço  marca/desmarca"/>
                </Grid>

                <ProgressBar Height="6" Margin="0,6,0,4" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"/>

                <DockPanel>
                    <Expander Header="Detalhes da execução (log e avisos)" IsExpanded="{Binding BottomExpanded, Mode=TwoWay}" FontSize="12">
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0" Padding="8">
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Notices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ExecutionSummary}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
