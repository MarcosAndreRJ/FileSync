<UserControl x:Class="SyncManager.Wpf.Views.Pages.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls">
    <!-- Página "Logs": o log desta sessão ao vivo (o arquivo completo fica na pasta de logs). DataContext = MainViewModel. -->
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="{StaticResource IconDocument}" Width="36" Height="36" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="Logs"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Eventos desta sessão, em tempo real."/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="0">
            <ListBox x:Name="SessionLog" ItemsSource="{Binding LogLines}" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Log da sessão"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenLogFolderButton" Content="Abrir pasta de logs" Padding="18,8" Margin="0" ctl:Icon.Data="{StaticResource IconFolder}" Command="{Binding OpenLogFolderCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
