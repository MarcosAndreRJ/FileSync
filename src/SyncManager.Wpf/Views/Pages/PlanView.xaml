<UserControl x:Class="SyncManager.Wpf.Views.Pages.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls">
    <!-- Página "Plano de execução". DataContext = MainViewModel; o conteúdo vem de Plan (PlanPreviewViewModel). Somente leitura. -->
    <UserControl.Resources>
        <Style x:Key="PlanStatusIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconPlay}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="skip"><Setter Property="Data" Value="{StaticResource IconBlock}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="conflict"><Setter Property="Data" Value="{StaticResource IconWarning}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="error"><Setter Property="Data" Value="{StaticResource IconError}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ToolTip" Value="{Binding Reason}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="conflict"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="error"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D6E6FF"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PathCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Detail}"/>
        </Style>

        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- cabeçalho -->
            <RowDefinition Height="Auto"/>   <!-- cartões -->
            <RowDefinition Height="Auto"/>   <!-- avisos -->
            <RowDefinition Height="Auto"/>   <!-- filtros -->
            <RowDefinition Height="*" MinHeight="100"/>   <!-- lista -->
            <RowDefinition Height="Auto"/>   <!-- rodapé / botões -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="{StaticResource IconDocument}" Width="36" Height="36" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="Plano de execução"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Plan.Header}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Plan.Cards}" AutomationProperties.Name="Resumo do plano">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctl:SummaryCard Value="{Binding Value}" Label="{Binding Label}" Accent="{Binding Brush}" IconKey="{Binding IconKey}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Plan.DataText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Plan.Notices}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Mostrar:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedText}"/>
            <ComboBox Width="200" ItemsSource="{Binding Plan.Filters}" SelectedItem="{Binding Plan.SelectedFilter}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Filtro do plano"/>
            <TextBox Width="260" Margin="8,0,0,0" Text="{Binding Plan.Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar arquivo..."
                     AutomationProperties.Name="Pesquisar no plano"/>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" Text="{Binding Plan.VisibleText}"/>
        </StackPanel>

        <DataGrid Grid.Row="4" x:Name="PlanGrid" Margin="0,8,0,0" ItemsSource="{Binding Plan.View}" AutoGenerateColumns="False" IsReadOnly="True"
                  RowStyle="{StaticResource PlanRowStyle}" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="28"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Operações do plano">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Operação" Width="150" SortMemberPath="Label">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Origem" Binding="{Binding FromDisplay}" Width="*" MinWidth="160" SortMemberPath="From" ElementStyle="{StaticResource PathCell}"/>
                <DataGridTextColumn Header="Destino" Binding="{Binding ToDisplay}" Width="*" MinWidth="160" SortMemberPath="To" ElementStyle="{StaticResource PathCell}"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="90" SortMemberPath="SizeSort" ElementStyle="{StaticResource RightAligned}"/>
                <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource PlanStatusIcon}" Fill="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Plan.Footer}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PlanBackButton" Content="Voltar" Padding="18,8" ctl:Icon.Data="{StaticResource IconArrowLeft}" Command="{Binding BackCommand}"/>
                <Button x:Name="PlanExportButton" Content="Exportar lista" Padding="18,8" ctl:Icon.Data="{StaticResource IconDownload}" Command="{Binding ExportPlanCommand}"
                        ToolTip="Salva em CSV as operações que estão na lista (respeitando filtro e pesquisa)"/>
                <Button x:Name="PlanExecuteButton" Content="EXECUTAR" Style="{StaticResource SuccessButton}" Padding="26,8" MinWidth="140" Margin="0"
                        ctl:Icon.Data="{StaticResource IconPlay}" Command="{Binding ExecuteCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
