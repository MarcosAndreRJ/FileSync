<UserControl x:Class="SyncManager.Wpf.Views.Pages.ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls">
    <!-- Página "Execução". DataContext = MainViewModel; o conteúdo vem de Execution (ExecutionViewModel). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OpStatusIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconCheck}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="running"><Setter Property="Data" Value="{StaticResource IconSync}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="skip"><Setter Property="Data" Value="{StaticResource IconBlock}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="warning"><Setter Property="Data" Value="{StaticResource IconWarning}"/></DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="error"><Setter Property="Data" Value="{StaticResource IconError}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- cabeçalho -->
            <RowDefinition Height="Auto"/>   <!-- progresso -->
            <RowDefinition Height="Auto"/>   <!-- resultado -->
            <RowDefinition Height="*" MinHeight="100"/>   <!-- operações -->
            <RowDefinition Height="Auto"/>   <!-- botões -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="{StaticResource IconPlay}" Width="36" Height="36" Stretch="Uniform" Fill="{DynamicResource SuccessBrush}" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Execution.ProfileName, StringFormat=Execução — {0}}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Execution.Title}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <!-- Progresso -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="16,12" AutomationProperties.Name="Progresso da execução">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Operação atual" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding Execution.CurrentOperation}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Execution.CurrentOperation}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Execution.PercentText}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <ProgressBar Height="12" Margin="0,8,0,10" Minimum="0" Maximum="100" Value="{Binding Execution.Percent, Mode=OneWay}"
                             AutomationProperties.Name="Progresso"/>
                <UniformGrid Rows="1">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="Arquivos" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Execution.FilesText}" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="Dados" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Execution.BytesText}" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="Velocidade" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Execution.SpeedText}" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="Tempo decorrido" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Execution.ElapsedText}" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0">
                        <StackPanel><TextBlock Text="Tempo restante" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Execution.RemainingText}" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Resultado (aparece quando termina) -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,8,0,0" Padding="14,10"
                Visibility="{Binding Execution.IsFinished, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Resultado da execução">
            <StackPanel Orientation="Horizontal">
                <Path ctl:Icon.Key="{Binding Execution.ResultIcon}" Width="26" Height="26" Stretch="Uniform" Fill="{Binding Execution.ResultBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="{Binding Execution.ResultTitle}" FontSize="15" FontWeight="Bold" Foreground="{Binding Execution.ResultBrush}"/>
                    <TextBlock Text="{Binding Execution.ResultText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lista de operações -->
        <DataGrid Grid.Row="3" x:Name="OperationsGrid" Margin="0,8,0,0" ItemsSource="{Binding Execution.Operations}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="28"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Operações executadas">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hora" Binding="{Binding Time}" Width="80"/>
                <DataGridTemplateColumn Header="Operação" Width="150" SortMemberPath="Operation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Operation}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Arquivo" Binding="{Binding File}" Width="*" MinWidth="200"/>
                <DataGridTemplateColumn Header="Status" Width="140" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource OpStatusIcon}" Fill="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ExecCancelButton" Content="Cancelar" Style="{StaticResource DangerButton}" Padding="22,8" MinWidth="120" Margin="0"
                    ctl:Icon.Data="{StaticResource IconBlock}" Command="{Binding CancelCommand}"
                    Visibility="{Binding Execution.IsRunning, Converter={StaticResource BoolToVis}}"/>
            <Button x:Name="ExecLogButton" Content="Abrir pasta de logs" Padding="18,8"
                    ctl:Icon.Data="{StaticResource IconDocument}" Command="{Binding OpenLogFolderCommand}"
                    Visibility="{Binding Execution.IsFinished, Converter={StaticResource BoolToVis}}"/>
            <Button x:Name="ExecBackButton" Content="Voltar à comparação" Padding="18,8" Margin="0"
                    ctl:Icon.Data="{StaticResource IconArrowLeft}" Command="{Binding BackCommand}"
                    Visibility="{Binding Execution.IsFinished, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
