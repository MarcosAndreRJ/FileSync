<UserControl x:Class="SyncManager.Wpf.Views.Pages.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls">
    <!-- Página "Perfis": lista + painel de detalhes. DataContext = MainViewModel; o conteúdo vem de Profiles (ProfilesViewModel). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource SmallMutedText}">
            <Setter Property="Margin" Value="0,10,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconProfiles}" Width="36" Height="36" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Perfis"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Configurações salvas de comparação e sincronização. Dê dois cliques para editar."/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" x:Name="NewProfileButton" Content="Novo perfil" Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="0"
                    ctl:Icon.Data="{StaticResource IconAdd}" Command="{Binding Profiles.NewCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ProfilesGrid" ItemsSource="{Binding Profiles.Rows}" SelectedItem="{Binding Profiles.Selected}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" RowHeight="30" MouseDoubleClick="OnDoubleClick" AutomationProperties.Name="Lista de perfis">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.1*" MinWidth="130"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Última execução" Binding="{Binding LastRunText}" Width="140"/>
                    <DataGridTemplateColumn Header="Status" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Estado vazio -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,170,0"
                        Visibility="{Binding Profiles.IsEmpty, Converter={StaticResource BoolToVis}}">
                <Path Data="{StaticResource IconProfiles}" Width="44" Height="44" Stretch="Uniform" Fill="{DynamicResource DisabledBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nenhum perfil salvo" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2" HorizontalAlignment="Center"/>
                <TextBlock Text="Use &quot;Novo perfil&quot; para criar o primeiro." Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Detalhes do perfil selecionado -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="12,0,0,0" Padding="16" x:Name="DetailsPanel"
                    Visibility="{Binding Profiles.HasSelection, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Profiles.Selected}">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MethodText}" Style="{StaticResource MutedText}"/>

                        <TextBlock Text="Source (origem)" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding Source}" TextWrapping="Wrap"/>
                        <TextBlock Text="Target (destino)" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding Target}" TextWrapping="Wrap"/>
                        <TextBlock Text="Opções" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding OptionsText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Última execução" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding LastRunText}"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Agendamento" Style="{StaticResource DetailLabel}"/>
                        <TextBlock Text="{Binding ScheduleText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NextRunText, StringFormat=Próxima execução: {0}}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Profiles.Message}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="EditProfileButton" Content="Editar" Padding="16,8" ctl:Icon.Data="{StaticResource IconSettings}" Command="{Binding Profiles.EditCommand}"/>
                <Button Content="Duplicar" Padding="16,8" ctl:Icon.Data="{StaticResource IconCopy}" Command="{Binding Profiles.DuplicateCommand}"/>
                <Button Content="Agendar" Padding="16,8" ctl:Icon.Data="{StaticResource IconCalendar}" Command="{Binding Profiles.ScheduleCommand}"
                        ToolTip="Define quando este perfil roda sozinho (Agendador de Tarefas do Windows)."/>
                <Button Content="Zerar histórico de sync" Padding="16,8" Command="{Binding Profiles.ResetSyncStateCommand}"
                        ToolTip="Só para perfis de Sincronização: esquece a última sincronização (a próxima será tratada como a primeira)."/>
                <Button Content="Excluir" Padding="16,8" ctl:Icon.Data="{StaticResource IconDelete}" Command="{Binding Profiles.DeleteCommand}"/>
                <Button x:Name="CompareProfileButton" Content="Comparar" Padding="18,8" Margin="18,0,8,0" ctl:Icon.Data="{StaticResource IconSearch}" Command="{Binding Profiles.CompareCommand}"/>
                <Button x:Name="RunProfileButton" Content="Executar agora" Style="{StaticResource SuccessButton}" Padding="20,8" Margin="0" ctl:Icon.Data="{StaticResource IconPlay}"
                        Command="{Binding Profiles.ExecuteCommand}"
                        ToolTip="Compara, mostra o plano para conferência e só então pede a confirmação para executar."/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
