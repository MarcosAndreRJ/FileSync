<Window x:Class="SyncManager.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
        xmlns:pages="clr-namespace:SyncManager.Wpf.Views.Pages"
        Title="{Binding WindowTitle}"
        Width="1400" Height="920" MinWidth="1050" MinHeight="680"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de título / cabeçalho superior moderna e compacta conforme mockups -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8,14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Identidade visual: Ícone e Título do aplicativo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCompare}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="FileSync" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                    <TextBlock Text="Comparar e sincronizar pastas" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navegação principal e ferramentas secundárias -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="Comparação" Command="{Binding ShowComparisonCommand}"
                            Tag="{Binding ComparisonNavTag}" Padding="12,5" Margin="0,0,4,0" ctl:Icon.Data="{StaticResource IconCompare}"
                            ToolTip="Comparar e sincronizar pastas"/>
                    <Button Style="{StaticResource NavButton}" Content="Perfis" Command="{Binding ManageProfilesCommand}"
                            Tag="{Binding ProfilesNavTag}" Padding="10,5" Margin="0,0,4,0" ctl:Icon.Data="{StaticResource IconProfiles}"
                            ToolTip="Gerenciar perfis salvos"/>
                    <Button Style="{StaticResource NavButton}" Content="Histórico" Command="{Binding ShowHistoryCommand}"
                            Tag="{Binding HistoryNavTag}" Padding="10,5" Margin="0,0,4,0" ctl:Icon.Data="{StaticResource IconHistory}"
                            ToolTip="Histórico de execuções"/>
                    <Button Style="{StaticResource NavButton}" Content="Logs" Command="{Binding ShowLogsCommand}"
                            Tag="{Binding LogsNavTag}" Padding="10,5" Margin="0,0,4,0" ctl:Icon.Data="{StaticResource IconDocument}"
                            ToolTip="Visualizar logs do sistema"/>
                    <Button Style="{StaticResource NavButton}" Content="Agendamentos" Command="{Binding ShowSchedulesCommand}"
                            Tag="{Binding SchedulesNavTag}" Padding="10,5" Margin="0,0,4,0" ctl:Icon.Data="{StaticResource IconCalendar}"
                            ToolTip="Agendamentos automáticos"/>
                    <Button Style="{StaticResource NavButton}" Content="Configurações" Command="{Binding ShowSettingsCommand}"
                            Tag="{Binding SettingsNavTag}" Padding="10,5" Margin="0,0,4,0" ctl:Icon.Data="{StaticResource IconSettings}"
                            ToolTip="Configurações globais"/>
                    <Button Style="{StaticResource NavButton}" Content="Ajuda" Command="{Binding AboutCommand}"
                            Padding="10,5" Margin="0,0,0,0" ctl:Icon.Data="{StaticResource IconHelp}"
                            ToolTip="Sobre o FileSync"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área principal de conteúdo em tela cheia (sem sidebar de 200px) -->
        <Grid>
            <pages:ComparisonView x:Name="ComparisonPage" Visibility="{Binding IsComparisonScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:PlanView x:Name="PlanPage" Visibility="{Binding IsPlanScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:ExecutionView x:Name="ExecutionPage" Visibility="{Binding IsExecutionScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:ProfilesView x:Name="ProfilesPage" Visibility="{Binding IsProfilesScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:ProfileEditorView x:Name="ProfileEditorPage" Visibility="{Binding IsEditorScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:SchedulesView x:Name="SchedulesPage" Visibility="{Binding IsSchedulesScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:HistoryView x:Name="HistoryPage" Visibility="{Binding IsHistoryScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:LogsView x:Name="LogsPage" Visibility="{Binding IsLogsScreen, Converter={StaticResource BoolToVis}}"/>
            <pages:SettingsView x:Name="SettingsPage" Visibility="{Binding IsSettingsScreen, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DockPanel>
</Window>
