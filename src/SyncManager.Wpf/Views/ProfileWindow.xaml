<Window x:Class="SyncManager.Wpf.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SyncManager.Wpf.Controls"
        xmlns:pages="clr-namespace:SyncManager.Wpf.Views.Pages"
        Title="{Binding Title}"
        Width="920" Height="680" MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource SmallMutedText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <DataTemplate x:Key="FilterRow">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Padrão"/>
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,5" ctl:Icon.Data="{StaticResource IconDelete}" ctl:Icon.Size="16" ToolTip="Remover"
                        AutomationProperties.Name="Remover padrão"
                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSettings}" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" FontSize="18"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Configurações do perfil, filtros, método de sincronização e segurança."/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Erros -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,0,10" Padding="10,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Conteúdo com Abas Laterais -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu Lateral -->
            <Border Style="{StaticResource PanelBorder}" Padding="0,8" VerticalAlignment="Stretch">
                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Content="Geral" Tag="{Binding GeneralTag}" ctl:Icon.Data="{StaticResource IconProfiles}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="General"/>
                    <Button Style="{StaticResource NavButton}" Content="Comparação" Tag="{Binding MethodTag}" ctl:Icon.Data="{StaticResource IconCompare}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Method"/>
                    <Button Style="{StaticResource NavButton}" Content="Filtros" Tag="{Binding FiltersTag}" ctl:Icon.Data="{StaticResource IconBlock}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Filters"/>
                    <Button Style="{StaticResource NavButton}" Content="Execução &amp; Segurança" Tag="{Binding AdvancedTag}" ctl:Icon.Data="{StaticResource IconShield}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Advanced"/>
                    <Button Style="{StaticResource NavButton}" Content="Agendamento" Tag="{Binding ScheduleTag}" ctl:Icon.Data="{StaticResource IconCalendar}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Schedule"/>
                </StackPanel>
            </Border>

            <!-- Painel de Detalhes -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="12,0,0,0" Padding="18,14">
                <Grid>
                    <!-- GERAL -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Geral"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Defina as informações básicas do perfil e os diretórios de origem e destino." Margin="0,2,0,8"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nome do perfil"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do perfil"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Origem (Source)"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pasta Source"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,6" ctl:Icon.Data="{StaticResource IconFolder}" Command="{Binding BrowseSourceCommand}" ToolTip="Procurar pasta"/>
                            </Grid>
                            <TextBlock Text="{Binding SourceTestText}" Foreground="{Binding SourceTestBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Destino (Target)"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pasta Target"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,6" ctl:Icon.Data="{StaticResource IconFolder}" Command="{Binding BrowseTargetCommand}" ToolTip="Procurar pasta"/>
                            </Grid>
                            <TextBlock Text="{Binding TargetTestText}" Foreground="{Binding TargetTestBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>

                            <Button Content="Testar conexões" HorizontalAlignment="Left" Padding="16,8" Margin="0,12,0,0"
                                    ctl:Icon.Data="{StaticResource IconSync}" Command="{Binding TestConnectionsCommand}"
                                    ToolTip="Confere se as duas pastas estão acessíveis. Não altera arquivos."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,4" Text="Método de sincronização"/>
                            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label"
                                      ToolTip="{Binding SelectedMethod.Description}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="Opções básicas"/>
                            <WrapPanel>
                                <CheckBox Content="Incluir subpastas" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,18,6"/>
                                <CheckBox Content="Incluir arquivos ocultos" IsChecked="{Binding IncludeHidden}" Margin="0,0,18,6"/>
                                <CheckBox Content="Incluir arquivos de sistema" IsChecked="{Binding IncludeSystem}" Margin="0,0,18,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- COMPARAÇÃO -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsMethod, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Comparação"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Defina os critérios e tolerâncias utilizados para detectar arquivos idênticos ou alterados." Margin="0,2,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Tolerância de data (segundos):" VerticalAlignment="Center" Width="210"/>
                                <TextBox Width="60" Text="{Binding ToleranceSeconds, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                            </StackPanel>

                            <CheckBox Content="Verificar conteúdo por hash SHA-256 (quando tamanho e data forem iguais)" IsChecked="{Binding VerifyContentByHash}" Margin="0,12,0,4"/>
                            <CheckBox Content="Conferir hash da cópia antes de substituir o arquivo no destino" IsChecked="{Binding VerifyCopyByHash}" Margin="0,4"/>
                            <CheckBox Content="Preservar data de modificação dos arquivos" IsChecked="{Binding PreserveTimestamps}" Margin="0,4"/>
                            <CheckBox Content="Preservar atributos de arquivo" IsChecked="{Binding PreserveAttributes}" Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- FILTROS -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFilters, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Filtros"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Sintaxe: *.tmp (nome em qualquer nível), Thumbs.db, pasta\ (somente pastas), src\obj (caminho relativo)."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Padrões para Excluir"/>
                            <ItemsControl ItemsSource="{Binding Excludes}" ItemTemplate="{StaticResource FilterRow}" AutomationProperties.Name="Padrões de exclusão"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewExclude, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Novo padrão de exclusão"/>
                                <Button Grid.Column="1" Content="Adicionar" Margin="6,0,0,0" Padding="14,6" ctl:Icon.Data="{StaticResource IconAdd}" ctl:Icon.Size="16" Command="{Binding AddExcludeCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,4" Text="Incluir somente (opcional; vazio = tudo)"/>
                            <ItemsControl ItemsSource="{Binding Includes}" ItemTemplate="{StaticResource FilterRow}" AutomationProperties.Name="Padrões de inclusão"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewInclude, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Novo padrão de inclusão"/>
                                <Button Grid.Column="1" Content="Adicionar" Margin="6,0,0,0" Padding="14,6" ctl:Icon.Data="{StaticResource IconAdd}" ctl:Icon.Size="16" Command="{Binding AddIncludeCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,4" Text="Comportamento dos filtros"/>
                            <CheckBox Content="Diferenciar maiúsculas de minúsculas" IsChecked="{Binding FilterCaseSensitive}" Margin="0,3"/>
                            <CheckBox Content="Usar curingas (* e ?)" IsChecked="{Binding FilterWildcards}" Margin="0,3"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- EXECUÇÃO E SEGURANÇA -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Execução e Segurança"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Estratégia de exclusão"/>
                            <ComboBox ItemsSource="{Binding DeleteOptions}" SelectedItem="{Binding SelectedDeleteOption}" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="360"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4" Text="Pasta de segurança (Backup antes de sobrescrever/excluir)"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SafetyFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pasta de segurança"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,6" ctl:Icon.Data="{StaticResource IconFolder}" Command="{Binding BrowseSafetyCommand}" ToolTip="Procurar pasta"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="Vazio = pasta .SyncBackup dentro do destino."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,4" Text="Opções de segurança"/>
                            <CheckBox Content="Guardar a versão anterior antes de sobrescrever" IsChecked="{Binding BackupBeforeOverwrite}" Margin="0,3"/>
                            <CheckBox Content="Confirmar antes de excluir arquivos" IsChecked="{Binding ConfirmDeletes}" Margin="0,3"/>
                            <CheckBox Content="Continuar quando um arquivo falhar" IsChecked="{Binding ContinueOnError}" Margin="0,3"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Exigir confirmação reforçada acima de (% de exclusões):" VerticalAlignment="Center" Width="340"/>
                                <TextBox Width="60" Text="{Binding MassDeletePercent, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,4" Text="Desempenho e tolerância"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Operações em paralelo (0 = automático):" VerticalAlignment="Center" Width="340"/>
                                <TextBox Width="60" Text="{Binding MaxParallel, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Tentativas extras em erro temporário:" VerticalAlignment="Center" Width="340"/>
                                <TextBox Width="60" Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Espera entre tentativas (ms):" VerticalAlignment="Center" Width="340"/>
                                <TextBox Width="80" Text="{Binding RetryDelayMs, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AGENDAMENTO -->
                    <Grid Visibility="{Binding IsSchedule, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Agendamento" Margin="0,0,0,8"/>
                            <pages:ScheduleEditorView DataContext="{Binding Schedule}" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   Style="{StaticResource MutedText}" Visibility="{Binding CannotSchedule, Converter={StaticResource BoolToVis}}"
                                   Text="Salve o perfil primeiro para poder programar agendamentos automáticos."/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Botões de Ação Inferiores -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Restaurar padrões" DockPanel.Dock="Left" Padding="16,8" Command="{Binding RestoreDefaultsCommand}"
                    ToolTip="Restaura os valores padrões recomendados"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="20,8" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Aplicar" Padding="20,8" Margin="0,0,8,0" Click="OnApplyClick"
                        ToolTip="Aplica as configurações na tela principal sem fechar esta janela"/>
                <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Padding="26,8" Click="OnSaveClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
