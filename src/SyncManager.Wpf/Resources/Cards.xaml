<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Painel branco com borda suave (nome antigo mantido: telas ainda não refatoradas usam) -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource PanelBorder}"/>

    <!-- Cartões Source (azul claro) e Target (verde claro), como nos mockups -->
    <Style x:Key="SourceCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
        <Setter Property="Background" Value="{DynamicResource SourceTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SourceBorderBrush}"/>
    </Style>

    <Style x:Key="TargetCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
        <Setter Property="Background" Value="{DynamicResource TargetTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TargetBorderBrush}"/>
    </Style>

    <!-- Cartão de indicador (número grande + legenda) -->
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>

    <!-- Barra lateral de navegação -->
    <Style x:Key="SidebarBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
</ResourceDictionary>
